# Local development only. Run make configure-local to generate local credentials.
JOCKY_ENVIRONMENT=development
JOCKY_MODE=REAL
JOCKY_TRANSPORT_MODE=DIRECT
JOCKY_API_URL=http://127.0.0.1:8000
# Path to a native jockyc executable for Workbench / Compiler Explorer requests.
# JOCKY_COMPILER_PATH=/absolute/path/to/jockyc
JOCKY_DATABASE_URL=postgresql+psycopg://jocky:CHANGE_ME@127.0.0.1:15432/jocky
POSTGRES_USER=jocky
POSTGRES_DB=jocky
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=jocky-local
MINIO_ROOT_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
JOCKY_BOOTSTRAP_PASSWORD=GENERATE_WITH_CONFIGURE_LOCAL
# TLS enrollment: 50052. Enrolled mTLS exchange: 50051.
